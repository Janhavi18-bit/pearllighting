# Pearl Lighting - Server-Side Notification Environment Configuration
# NOTE: Never commit sensitive credentials or .env to version control!

# Destination email for new customer product enquiries
NOTIFICATION_EMAIL=pearlleddriver@gmail.com

# Resend Email Delivery Configuration (https://resend.com)
# 1. Sign up for a free account at https://resend.com
# 2. Generate an API Key under API Keys (starts with 're_')
# 3. Paste the key below:
RESEND_API_KEY=

# Verified sender address:
# - During development/sandbox, you can send from: Pearl Lighting <onboarding@resend.dev>
#   (Note: Resend onboarding sandbox sends only to the account owner's registered email)
# - For production sending to any address, add and verify your custom domain in Resend:
#   RESEND_FROM_EMAIL=Pearl Lighting <enquiry@yourverifieddomain.com>
RESEND_FROM_EMAIL=Pearl Lighting <onboarding@resend.dev>

# Live Email Sending Flag:
# - Set to false: Safely simulates email creation, attachment verification, and logging.
# - Set to true: Dispatches real emails via Resend to NOTIFICATION_EMAIL.
SEND_REAL_EMAILS=false

# Public Production URL (used to generate valid HTTPS image links in notification emails)
PUBLIC_APP_URL=https://pearl-lighting.vercel.app

# Optional server port for standalone backend server (server/index.js)
PORT=3001

